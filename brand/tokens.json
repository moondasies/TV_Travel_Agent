{
  "name": "Bitu Universe (working title)",
  "canvas": { "width": 1080, "height": 1920, "fps": 30 },
  "color": {
    "ink": "#0D0B1E",
    "inkSoft": "#17142E",
    "panel": "#1F1B3D",
    "panelLine": "#2E2858",
    "cream": "#FFF6E9",
    "muted": "#A49FC8",
    "violet": "#7C5CFF",
    "violetDeep": "#5A3BE0",
    "lime": "#C6FF3D",
    "coral": "#FF5C7A",
    "cyan": "#3DE0FF",
    "sun": "#FFC83D"
  },
  "semantic": {
    "machine": "violet",
    "learning / correct / not-spam": "lime",
    "error / spam / fail": "coral",
    "data / examples": "cyan",
    "highlighted term in captions": "lime"
  },
  "font": {
    "display": "Baloo 2 ExtraBold (800)",
    "ui": "Baloo 2 SemiBold/Bold",
    "code": "JetBrains Mono Medium/Bold",
    "files": "brand/fonts/*.ttf (SIL Open Font License)"
  },
  "caption": {
    "font": "Baloo 2 ExtraBold",
    "size": 78,
    "centerY": 1395,
    "maxWidth": 880,
    "fill": "cream",
    "stroke": "ink",
    "strokeWidth": 14,
    "termColor": "lime",
    "safeZone": "visual content lives in y 170-1290; captions 1320-1480; y>1520 reserved for platform UI; keep 60px right margin clear for Shorts/Reels buttons"
  },
  "motion": {
    "enter": "easeOutBack 0.35-0.45s (pop)",
    "exit": "easeInCubic 0.25s",
    "sceneTransition": "violet->lime diagonal swipe, 0.42s, cut at midpoint",
    "emphasis": "stamp = scale 2.2->1 + rotate, 6px camera shake 0.25s",
    "idle": "Bitu hovers +-8px on a 2.2s sine; background dot-grid drifts 12px/s"
  }
}
